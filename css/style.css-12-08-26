#smooth-content {
  overflow: visible !important;
}

/* ================= HAMBURGER ICON ================= */
.mobile-menu {
  display: none;
  cursor: pointer;
  z-index: 10001;
  position: relative;
}
@media (max-width: 1179px) {
  .mobile-menu {
    display: block;
  }
}

.menu-icon {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: transparent !important;
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  -webkit-box-align: center;
      -ms-flex-align: center;
          align-items: center;
  -webkit-box-pack: center;
      -ms-flex-pack: center;
          justify-content: center;
  position: relative;
}

/* the 3 bars */
.menu-icon span {
  position: absolute;
  width: 25px;
  height: 2px;
  background: black;
  border-radius: 2px;
  -webkit-transition: all 0.35s cubic-bezier(0.68, -0.55, 0.27, 1.55);
  transition: all 0.35s cubic-bezier(0.68, -0.55, 0.27, 1.55);
  -webkit-transform-origin: center;
          transform-origin: center;
}

/* bar positions */
.menu-icon span:nth-child(1) {
  -webkit-transform: translateY(-6px);
          transform: translateY(-6px);
}

.menu-icon span:nth-child(2) {
  -webkit-transform: translateY(0);
          transform: translateY(0);
}

.menu-icon span:nth-child(3) {
  -webkit-transform: translateY(6px);
          transform: translateY(6px);
}

/* ================= ACTIVE STATE (TO X) ================= */
.site-header.mobileactive .menu-icon span:nth-child(1) {
  -webkit-transform: rotate(45deg);
          transform: rotate(45deg);
}

.site-header.mobileactive .menu-icon span:nth-child(2) {
  opacity: 0;
  -webkit-transform: scaleX(0);
          transform: scaleX(0);
}

.site-header.mobileactive .menu-icon span:nth-child(3) {
  -webkit-transform: rotate(-45deg);
          transform: rotate(-45deg);
}

/* ===============================
  PRELOADER (FULL SCREEN)
================================ */
#preloader {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: #ffffff;
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  -webkit-box-align: center;
      -ms-flex-align: center;
          align-items: center;
  -webkit-box-pack: center;
      -ms-flex-pack: center;
          justify-content: center;
  z-index: 9999999;
  -webkit-transition: opacity 0.5s ease, visibility 0.5s ease;
  transition: opacity 0.5s ease, visibility 0.5s ease;
}

/* ===============================
  LOGO WRAPPER
================================ */
.loader-logo {
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  -webkit-box-align: center;
      -ms-flex-align: center;
          align-items: center;
  -webkit-box-pack: center;
      -ms-flex-pack: center;
          justify-content: center;
}
.loader-logo img {
  width: 300px;
  height: auto;
  display: block;
  /* Animation */
  -webkit-animation: logoPulse 1.5s ease-in-out infinite;
          animation: logoPulse 1.5s ease-in-out infinite;
}

/* ===============================
  LOGO ANIMATION (Pulse)
================================ */
@-webkit-keyframes logoPulse {
  0% {
    opacity: 0.4;
    -webkit-transform: scale(0.95);
            transform: scale(0.95);
  }
  50% {
    opacity: 1;
    -webkit-transform: scale(1);
            transform: scale(1);
  }
  100% {
    opacity: 0.4;
    -webkit-transform: scale(0.95);
            transform: scale(0.95);
  }
}
@keyframes logoPulse {
  0% {
    opacity: 0.4;
    -webkit-transform: scale(0.95);
            transform: scale(0.95);
  }
  50% {
    opacity: 1;
    -webkit-transform: scale(1);
            transform: scale(1);
  }
  100% {
    opacity: 0.4;
    -webkit-transform: scale(0.95);
            transform: scale(0.95);
  }
}
/* ===============================
  BODY LOCK (PREVENT SCROLL)
================================ */
body.loading {
  overflow: hidden;
}

/* ===============================
  OPTIONAL: SMOOTH FADE OUT STATE
================================ */
#preloader.hide {
  opacity: 0;
  visibility: hidden;
}

