.alumimi-slide {
  background-color: #FCF8F1;
  position: relative;
}
.alumimi-slide::before {
  position: absolute;
  content: "";
  width: 100%;
  height: 80px;
  background: #890E0E;
  display: block;
}
.alumimi-slide .aluminiSwiper {
  max-width: 600px;
  position: relative;
}
.alumimi-slide .aluminiSwiper .ellipse-yellow {
  position: absolute;
  top: 66px;
  left: 0;
  z-index: 99;
  width: 24px;
  height: 24px;
  background: transparent;
  border: 2px solid #FFC700;
  border-radius: 50%;
  display: block;
  -webkit-animation: yellow-circle 4s infinite;
          animation: yellow-circle 4s infinite;
  opacity: 0;
}
@-webkit-keyframes yellow-circle {
  25% {
    border-color: #28be4b;
    opacity: 0.5;
  }
  50% {
    margin-left: 126px;
    opacity: 1;
  }
  75% {
    border-color: #f8f404;
  }
}
@keyframes yellow-circle {
  25% {
    border-color: #28be4b;
    opacity: 0.5;
  }
  50% {
    margin-left: 126px;
    opacity: 1;
  }
  75% {
    border-color: #f8f404;
  }
}
.alumimi-slide .aluminiSwiper .top-right-ellipse {
  position: absolute;
  top: 0;
  right: 10px;
  width: 44px;
  height: 44px;
  background: transparent;
  border: 2px solid rgba(167, 220, 255, 0.2);
  border-radius: 50%;
  display: block;
  -webkit-animation: top-right-circle 5s infinite;
          animation: top-right-circle 5s infinite;
  margin-right: 0;
  opacity: 0;
}
@-webkit-keyframes top-right-circle {
  25% {
    border-color: #28b4be;
    opacity: 0.5;
  }
  50% {
    margin-right: 90px;
    opacity: 1;
  }
  75% {
    border-color: #b490ee;
  }
}
@keyframes top-right-circle {
  25% {
    border-color: #28b4be;
    opacity: 0.5;
  }
  50% {
    margin-right: 90px;
    opacity: 1;
  }
  75% {
    border-color: #b490ee;
  }
}
.alumimi-slide .aluminiSwiper .ellipse-big {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 70px;
  height: 70px;
  background: transparent;
  border: 2px solid #105c8e;
  border-radius: 50%;
  display: block;
  -webkit-animation: big-circle 3s infinite;
          animation: big-circle 3s infinite;
  margin-bottom: 0;
  margin-right: 0;
  opacity: 0;
}
@-webkit-keyframes big-circle {
  25% {
    border-color: #6228be;
    opacity: 0.5;
  }
  50% {
    margin-bottom: 40px;
    margin-right: 72px;
    opacity: 1;
  }
  75% {
    border-color: #be28af;
  }
}
@keyframes big-circle {
