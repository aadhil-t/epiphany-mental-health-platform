.ewd-ufaq-post-margin-symbol {
  display: none;
}

.ewd-ufaq-faq-title-text {
  position: relative;
  padding-right: 35px;
}
.ewd-ufaq-faq-title-text::before {
  content: "";
  width: 16px;
  height: 16px;
  background: url("../images/about/arrow.svg") no-repeat center;
  background-size: contain;
  position: absolute;
  right: 0;
  top: 50%;
  -webkit-transform: translateY(-50%) rotate(0deg);
          transform: translateY(-50%) rotate(0deg);
  -webkit-transition: -webkit-transform 0.3s ease;
  transition: -webkit-transform 0.3s ease;
  transition: transform 0.3s ease;
  transition: transform 0.3s ease, -webkit-transform 0.3s ease;
}

/* Active = arrow upward */
.ewd-ufaq-post-active .ewd-ufaq-post-margin::before,
.ewd-ufaq-faq-title[aria-expanded=true] .ewd-ufaq-faq-title-text::before {
  -webkit-transform: translateY(-50%) rotate(180deg);
          transform: translateY(-50%) rotate(180deg);
}

.ewd-ufaq-faq-title-text {
  padding: 24px 0;
  width: 100% !important;
}
