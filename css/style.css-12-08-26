/* Torn top shape */
.site-footer::before {
  content: "";
  position: absolute;
  top: -130px;
  left: 0;
  z-index: 1;
  width: 100%;
  height: 176px;
  background: url("../images/footer/cutting.svg") no-repeat center/cover;
  pointer-events: none;
}

/* ===============================
   TOP
================================ */
