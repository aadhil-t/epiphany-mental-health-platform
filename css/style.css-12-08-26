  display: flex;
  -webkit-box-align: center;
      -ms-flex-align: center;
          align-items: center;
  -webkit-box-pack: center;
      -ms-flex-pack: center;
          justify-content: center;
  -webkit-box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
          box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
}

/* CARD ROTATION */
.card-left {
  -webkit-transform: rotate(5deg);
          transform: rotate(5deg);
}

.card-center {
  -webkit-transform: rotate(0deg);
          transform: rotate(0deg);
}

.card-right {
  -webkit-transform: rotate(-5deg);
          transform: rotate(-5deg);
}

/* BOTTOM FLOWERS */
.team-bottom-img {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 220px;
  background: url("../images/flowers.png") no-repeat center bottom/cover;
  z-index: 1;
}

/* RESPONSIVE */
@media (max-width: 1225px) {
  .team-wrapper {
    -ms-flex-wrap: wrap;
        flex-wrap: wrap;
    -webkit-box-align: center;
        -ms-flex-align: center;
            align-items: center;
    gap: 50px;
  }
}
@media (max-width: 1225px) and (max-width: 500px) {
  .card-left {
    -webkit-transform: rotate(5deg);
            transform: rotate(5deg);
  }
}
@media (max-width: 1225px) and (max-width: 500px) {
  .card-right {
    -webkit-transform: rotate(-5deg);
            transform: rotate(-5deg);
  }
}
@media (max-width: 1225px) and (max-width: 450px) {
  .team-wrapper {
    -webkit-box-pack: unset;
        -ms-flex-pack: unset;
            justify-content: unset;
  }
}
@media (max-width: 1225px) and (max-width: 388px) {
  .team-wrapper {
    -webkit-box-pack: center;
        -ms-flex-pack: center;
            justify-content: center;
  }
}
.conditions-section {
  position: relative;
  padding: 160px 0 450px;
  text-align: center;
  overflow: hidden;
}
@media (max-width: 600px) {
  .conditions-section {
    padding: 130px 0 410px;
  }
}

/* BACKGROUND IMAGE */
.conditions-section::before {
  content: "";
  position: absolute;
  inset: 0;
  background: url("../images/condition/overlay.jpeg") no-repeat center/cover;
  opacity: 0.7;
  z-index: 0;
}

/* LIGHT WARM OVERLAY */
.conditions-section::after {
  content: "";
  position: absolute;
  inset: 0;
  background: -webkit-gradient(linear, left top, left bottom, from(rgba(195, 122, 27, 0.1)), to(rgba(195, 122, 27, 0.1)));
  background: linear-gradient(rgba(195, 122, 27, 0.1), rgba(195, 122, 27, 0.1));
  z-index: 0;
  pointer-events: none;
}

/* CONTENT ABOVE */
.conditions-section > * {
  position: relative;
  z-index: 2;
}

/* TITLE */
.conditions-title {
  color: #9b3d2b;
  margin-bottom: 37px;
  font-family: "Simple Serenity Serif";
  text-transform: uppercase;
}
@media (max-width: 500px) {
  .conditions-title {
    font-size: 40px;
    line-height: 55px;
  }
}

/* GRID */
.conditions-grid {
  display: -ms-grid;
  display: grid;
  -ms-grid-columns: 1fr 20px 1fr 20px 1fr;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

/* CARD BASE */
.condition-card {
  min-height: 360px;
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  -webkit-box-align: center;
      -ms-flex-align: center;
          align-items: center;
  -webkit-box-orient: vertical;
  -webkit-box-direction: normal;
      -ms-flex-direction: column;
          flex-direction: column;
  text-align: center;
  padding: 50px;
  background-size: cover;
  background-position: center;
  position: relative;
  color: #fff;
  overflow: hidden;
  /* IMPORTANT: helps match Figma blending */
  background-blend-mode: multiply;
}

/* =========================
   WATER COLOR CARDS
   (DEPTH + TEXTURE + COLOR)
========================= */
/* OCD (warm orange) */
.ocd {
  background: radial-gradient(circle at center, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 0.15) 100%), -webkit-gradient(linear, left top, left bottom, from(rgba(224, 154, 84, 0.8)), to(rgba(224, 154, 84, 0.8))), url("../images/condition/layer1.png") center/cover no-repeat;
  background: radial-gradient(circle at center, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 0.15) 100%), linear-gradient(rgba(224, 154, 84, 0.8), rgba(224, 154, 84, 0.8)), url("../images/condition/layer1.png") center/cover no-repeat;
}

/* PTSD (rich red) */
.ptsd {
  background: radial-gradient(circle at center, rgba(0, 0, 0, 0) 35%, rgba(0, 0, 0, 0.25) 100%), -webkit-gradient(linear, left top, left bottom, from(rgba(176, 55, 30, 0.8)), to(rgba(176, 55, 30, 0.8))), url("../images/condition/layer1.png") center/cover no-repeat;
  background: radial-gradient(circle at center, rgba(0, 0, 0, 0) 35%, rgba(0, 0, 0, 0.25) 100%), linear-gradient(rgba(176, 55, 30, 0.8), rgba(176, 55, 30, 0.8)), url("../images/condition/layer1.png") center/cover no-repeat;
}

/* Panic (deep plum) */
.panic {
  background: radial-gradient(circle at center, rgba(0, 0, 0, 0) 35%, rgba(0, 0, 0, 0.3) 100%), -webkit-gradient(linear, left top, left bottom, from(rgba(120, 45, 65, 0.8)), to(rgba(120, 45, 65, 0.8))), url("../images/condition/layer1.png") center/cover no-repeat;
  background: radial-gradient(circle at center, rgba(0, 0, 0, 0) 35%, rgba(0, 0, 0, 0.3) 100%), linear-gradient(rgba(120, 45, 65, 0.8), rgba(120, 45, 65, 0.8)), url("../images/condition/layer1.png") center/cover no-repeat;
}

/* TEXT CONTENT */
.card-content {
  position: relative;
  height: 100%;
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  -webkit-box-orient: vertical;
  -webkit-box-direction: normal;
      -ms-flex-direction: column;
          flex-direction: column;
  -webkit-box-align: center;
      -ms-flex-align: center;
          align-items: center;
}
.card-content h3 {
  font-size: 22px;
  margin-bottom: 18px;
  font-weight: 500;
  max-width: 15rem;
}
.card-content p {
  font-family: "Lato";
  font-weight: 300;
  font-style: Regular;
  font-size: 20px;
  line-height: 28px;
  letter-spacing: 0%;
  max-width: 17rem;
  margin-bottom: 25px;
  text-align: center;
  color: rgb(255, 255, 255);
}

/* BUTTON */
.btn-outline {
  display: inline-block;
  padding: 15px 22px;
  border: 1px solid #fff;
  border-radius: 30px;
  color: #fff !important;
  text-decoration: none;
  -webkit-transition: 0.3s ease;
  transition: 0.3s ease;
  font-family: "Lato";
  font-weight: 700;
  font-style: Bold;
  font-size: 14px;
  line-height: 100%;
  letter-spacing: 10%;
  text-transform: uppercase;
  margin-top: auto;
}

.btn-outline:hover {
  background: #fff;
  color: #1E1E1E !important;
}

/* VIEW ALL SERVICES */
.view-services {
  margin-top: 50px;
}
.view-services a {
  font-size: 16px;
  color: #82260F;
  text-decoration: none;
  position: relative;
  display: -webkit-inline-box;
  display: -ms-inline-flexbox;
  display: inline-flex;
  -webkit-box-align: center;
      -ms-flex-align: center;
          align-items: center;
  gap: 10px;
  font-family: "Lato";
  font-weight: 700;
  font-style: Bold;
  line-height: 100%;
  letter-spacing: 10%;
  text-transform: uppercase;
}
.view-services a::after {
  content: "";
  width: 13px;
  height: 13px;
  background: url("../images/condition/arrow.svg") no-repeat center;
  background-size: contain;
  display: inline-block;
  -webkit-transition: -webkit-transform 0.3s ease;
  transition: -webkit-transform 0.3s ease;
  transition: transform 0.3s ease;
  transition: transform 0.3s ease, -webkit-transform 0.3s ease;
}
.view-services a:hover::after {
  -webkit-transform: translateX(5px);
          transform: translateX(5px);
}

