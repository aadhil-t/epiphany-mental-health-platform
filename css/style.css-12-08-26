/* =====================================================
  HEADER BASE
===================================================== */
.site-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 6rem;
  z-index: 999999;
  -webkit-transition: background-color 0.3s ease, opacity 0.3s ease, -webkit-transform 0.4s ease, -webkit-box-shadow 0.3s ease;
  transition: background-color 0.3s ease, opacity 0.3s ease, -webkit-transform 0.4s ease, -webkit-box-shadow 0.3s ease;
  transition: transform 0.4s ease, background-color 0.3s ease, box-shadow 0.3s ease, opacity 0.3s ease;
  transition: transform 0.4s ease, background-color 0.3s ease, box-shadow 0.3s ease, opacity 0.3s ease, -webkit-transform 0.4s ease, -webkit-box-shadow 0.3s ease;
}
.site-header.is-sticky {
  backdrop-filter: blur(10px);
  -webkit-box-shadow: unset !important;
          box-shadow: unset !important;
}
.site-header.hide-header {
  -webkit-transform: translateY(-100%);
          transform: translateY(-100%);
  opacity: 0;
  background: transparent !important;
  -webkit-box-shadow: none !important;
          box-shadow: none !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  pointer-events: none;
}
.site-header.hide-header::before {
  opacity: 0;
  visibility: hidden;
}
.site-header::before {
  content: "";
  position: absolute;
  top: -28px;
  left: 0;
  width: 100%;
  height: 165px;
  background-image: url("../images/header/header-mask.png");
  background-size: cover;
  background-repeat: no-repeat;
  z-index: 0;
  pointer-events: none;
  -webkit-transition: opacity 0.3s ease, visibility 0.3s ease;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}
@media (max-width: 2560px) {
  .site-header::before {
    top: 0;
  }
}
@media (max-width: 1440px) {
  .site-header::before {
    top: 0;
  }
}
@media (max-width: 770px) {
  .site-header::before {
    top: -10px;
  }
}
.site-header.is-sticky {
  -webkit-box-shadow: 0px 10px 35px 0px rgba(0, 0, 0, 0.25);
          box-shadow: 0px 10px 35px 0px rgba(0, 0, 0, 0.25);
}
.site-header .container {
  height: 100%;
}
.site-header .header-content {
  height: 100%;
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  -webkit-box-align: center;
      -ms-flex-align: center;
          align-items: center;
  -webkit-box-pack: justify;
      -ms-flex-pack: justify;
          justify-content: space-between;
  position: relative;
}
.site-header .green-btn {
  margin-top: 0;
}
.site-header .green-btn a {
  color: #fff !important;
  padding: 0;
}
.site-header .green-btn:hover a {
  color: rgb(77, 152, 140) !important;
}

.site-header .header-content {
  position: relative;
  z-index: 2;
}

