  -webkit-box-align: start;
      -ms-flex-align: start;
          align-items: flex-start;
  margin: 0;
}
.therapy-expect ol li {
  position: relative;
  padding-left: 20px;
  margin-bottom: 10px;
  font-size: 17px;
  line-height: 35px;
  text-align: start;
  counter-increment: item;
}
.therapy-expect ol li::before {
  content: counter(item);
  position: absolute;
  color: rgb(195, 122, 27);
  left: 0;
  top: 4px;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  -webkit-box-align: center;
      -ms-flex-align: center;
