.faq-section {
  padding: 120px 0;
  background: -webkit-gradient(linear, left top, left bottom, from(rgba(244, 225, 214, 0.6)), to(rgba(244, 225, 214, 0.6))), url("../images/why-epiphany/bg.png");
  background: linear-gradient(rgba(244, 225, 214, 0.6), rgba(244, 225, 214, 0.6)), url("../images/why-epiphany/bg.png");
  background-size: cover;
  overflow: hidden;
}
.faq-section .faq-wrapper {
  display: -ms-grid;
  display: grid;
  -ms-grid-columns: 391px 30px 1fr;
  grid-template-columns: 391px 1fr;
  gap: 30px;
  -webkit-box-align: start;
      -ms-flex-align: start;
          align-items: flex-start;
}
@media (max-width: 991px) {
  .faq-section .faq-wrapper {
    -ms-grid-columns: 1fr;
    grid-template-columns: 1fr;
    gap: 40px;
  }
}
.faq-section .faq-left h2 {
  color: rgb(130, 38, 15);
  font-family: "Simple Serenity Serif";
  margin: 0;
}
.faq-section .faq-right {
  border-top: 1px solid rgba(0, 0, 0, 0.08);
}
.faq-section .faq-item {
  border-bottom: 1px solid rgba(0, 0, 0, 0.1);
}
.faq-section .faq-item.active .faq-answer {
  max-height: 500px;
  padding-bottom: 25px;
}
.faq-section .faq-item.active .arrow {
  -webkit-transform: rotate(180deg);
          transform: rotate(180deg);
}
.faq-section .faq-question {
  width: 100%;
  background: transparent;
  border: none;
  padding: 24px 0;
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  -webkit-box-align: center;
      -ms-flex-align: center;
          align-items: center;
  -webkit-box-pack: justify;
      -ms-flex-pack: justify;
          justify-content: space-between;
  gap: 20px;
  position: relative;
  cursor: pointer;
  text-align: left;
}
.faq-section .faq-question span {
  font-family: "Lato";
  font-weight: 400;
  font-style: Regular;
  font-size: 25px;
  line-height: 35px;
  letter-spacing: 0%;
  color: rgb(60, 24, 42);
  -webkit-box-flex: 1;
      -ms-flex: 1;
          flex: 1;
}
@media (max-width: 768px) {
  .faq-section .faq-question span {
    font-size: 20px;
    line-height: 30px;
  }
}
.faq-section .faq-question .arrow {
  width: 16px;
  height: 16px;
  min-width: 16px;
  background: url("../images/about/arrow.svg") no-repeat center;
  background-size: contain;
  -webkit-transition: -webkit-transform 0.3s ease;
  transition: -webkit-transform 0.3s ease;
  transition: transform 0.3s ease;
  transition: transform 0.3s ease, -webkit-transform 0.3s ease;
  -webkit-transform-origin: center;
          transform-origin: center;
  -ms-flex-negative: 0;
      flex-shrink: 0;
  top: 50%;
  left: 99%;
  -webkit-transform: translate(-50%, -50%);
          transform: translate(-50%, -50%);
  background-color: transparent;
  -webkit-box-shadow: none;
          box-shadow: none;
}
.faq-section .faq-answer {
  max-height: 0;
  overflow: hidden;
  -webkit-transition: max-height 0.4s ease, padding 0.4s ease;
  transition: max-height 0.4s ease, padding 0.4s ease;
}
.faq-section .faq-answer p {
  font-family: "Lato";
  font-weight: 400;
  font-style: Regular;
  font-size: 17px;
  line-height: 28px;
  letter-spacing: 0%;
  margin: 0 0 18px;
}
@media (max-width: 768px) {
  .faq-section .faq-answer p {
    font-size: 14px;
    line-height: 24px;
  }
}
.faq-section .faq-answer p:last-child {
  margin-bottom: 0;
}

.next-blog-sec {
  padding: 60px 0;
  background: -webkit-gradient(linear, left top, left bottom, from(rgba(255, 255, 255, 0.75)), to(rgba(255, 255, 255, 0.75))), url("../images/why-epiphany/bg.png");
  background: linear-gradient(rgba(255, 255, 255, 0.75), rgba(255, 255, 255, 0.75)), url("../images/why-epiphany/bg.png");
  background-size: cover;
  background-position: center;
}
.next-blog-sec .next-blog-wrapper {
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  -webkit-box-align: start;
      -ms-flex-align: start;
          align-items: flex-start;
  -webkit-box-pack: justify;
      -ms-flex-pack: justify;
          justify-content: space-between;
  gap: 60px;
}
.next-blog-sec .nav-blog {
  max-width: 360px;
  width: 100%;
}
.next-blog-sec .nav-blog a {
  display: -webkit-inline-box;
  display: -ms-inline-flexbox;
  display: inline-flex;
  -webkit-box-align: center;
      -ms-flex-align: center;
          align-items: center;
  gap: 8px;
  font-size: 12px;
  text-transform: capitalize;
  color: #555;
  text-decoration: none;
  margin-bottom: 12px;
  letter-spacing: 0.4px;
}
.next-blog-sec .nav-blog a img {
  width: 10px;
  height: 10px;
  -webkit-transition: 0.3s ease;
  transition: 0.3s ease;
}
.next-blog-sec .blog-info h3 {
  margin: 0;
  font-family: "Lato";
  font-weight: 400;
  font-style: Regular;
  font-size: 25px;
  line-height: 35px;
  font-weight: 400;
  color: rgb(60, 24, 42);
}
.next-blog-sec .prev-blog a img {
  -webkit-transform: rotate(90deg);
          transform: rotate(90deg);
}
.next-blog-sec {
  /* Hide previous by default */
}
.next-blog-sec .prev-blog {
  display: none;
}
.next-blog-sec {
  /* Only Next visible */
}
.next-blog-sec.has-only-next .next-blog-wrapper {
  -webkit-box-pack: end;
      -ms-flex-pack: end;
          justify-content: flex-end;
}
.next-blog-sec.has-only-next .prev-blog {
  display: none;
}
.next-blog-sec.has-only-next .next-blog {
  display: block;
}
.next-blog-sec {
  /* Show both */
}
.next-blog-sec.has-both .next-blog-wrapper {
  -webkit-box-pack: justify;
      -ms-flex-pack: justify;
          justify-content: space-between;
}
.next-blog-sec.has-both .prev-blog {
  display: block;
}
.next-blog-sec.has-both .next-blog {
  display: block;
}
.next-blog-sec {
  /* Only Previous */
}
.next-blog-sec.has-only-prev .next-blog-wrapper {
  -webkit-box-pack: start;
      -ms-flex-pack: start;
          justify-content: flex-start;
}
.next-blog-sec.has-only-prev .prev-blog {
  display: block;
}
.next-blog-sec.has-only-prev .next-blog {
  display: block;
}
.next-blog-sec {
  /* Hover */
}
.next-blog-sec .next-blog:hover a img {
  -webkit-transform: translatex(4px);
          transform: translatex(4px);
}
.next-blog-sec .prev-blog:hover a img {
  -webkit-transform: rotate(90deg) translatey(4px);
          transform: rotate(90deg) translatey(4px);
}
@media (max-width: 991px) {
  .next-blog-sec .next-blog-wrapper {
    -webkit-box-orient: vertical;
    -webkit-box-direction: normal;
        -ms-flex-direction: column;
            flex-direction: column;
    gap: 30px;
  }
  .next-blog-sec .blog-info h3 {
    font-size: 26px;
  }
}
@media (max-width: 575px) {
  .next-blog-sec {
    padding: 40px 0;
  }
  .next-blog-sec .blog-info h3 {
    font-size: 22px;
  }
}

.notfound_page {
  padding: 100px 0;
  background: -webkit-gradient(linear, left top, left bottom, from(rgba(244, 225, 214, 0.7)), to(rgba(244, 225, 214, 0.7))), url("../images/why-epiphany/bg.png");
