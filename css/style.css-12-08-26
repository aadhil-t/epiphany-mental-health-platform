.vintage-video-sec {
  padding: 40px 0 60px;
  position: relative;
  overflow: hidden;
}
.vintage-video-sec .container {
  width: min(1380px, 92%);
  margin: auto;
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex;
  -webkit-box-pack: center;
      -ms-flex-pack: center;
          justify-content: center;
  -webkit-box-align: center;
      -ms-flex-align: center;
          align-items: center;
}
.vintage-video-sec {
  /* =========================
      WHITE PAPER FRAME
  ========================= */
}
.vintage-video-sec .paper-frame {
  position: relative;
  width: 760px;
  background: #ffffff;
  padding: 8px 8px 54px;
  -webkit-box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.03), 0 12px 35px rgba(0, 0, 0, 0.06);
          box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.03), 0 12px 35px rgba(0, 0, 0, 0.06);
  /* =========================
      VIDEO BOX
  ========================= */
}
.vintage-video-sec .paper-frame .video-box {
  position: relative;
  width: 100%;
  aspect-ratio: 16/9;
  overflow: hidden;
  background: #ece9e4;
}
.vintage-video-sec .paper-frame .video-box iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: none;
}
.vintage-video-sec .paper-frame .video-box video {
  width: 100%;
}
.vintage-video-sec .paper-frame {
  /* =========================
      FULLSCREEN BUTTON
  ========================= */
}
.vintage-video-sec .paper-frame .video-text {
  position: absolute;
  left: 50%;
  bottom: 18px;
  -webkit-transform: translateX(-50%);
          transform: translateX(-50%);
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  font-family: "Lato";
  font-weight: 400;
  font-size: 18px;
  line-height: 28px;
  letter-spacing: 0%;
  color: #1A1818;
  text-align: center;
  white-space: nowrap;
  cursor: pointer;
  -webkit-transition: opacity 0.3s ease;
  transition: opacity 0.3s ease;
}
.vintage-video-sec .paper-frame .video-text:hover {
  opacity: 0.7;
}
.vintage-video-sec .paper-frame {
  /* =========================
      PAPER TAPE IMAGES
  ========================= */
}
.vintage-video-sec .paper-frame .tape {
  position: absolute;
  z-index: 5;
  pointer-events: none;
  opacity: 0.92;
  top: unset;
  left: unset;
}
.vintage-video-sec .paper-frame .tape-right {
  width: 107px;
  height: 60px;
  top: -7px;
  right: -27px;
  -webkit-transform: rotate(54deg);
          transform: rotate(54deg);
}
.vintage-video-sec .paper-frame .tape-left {
  width: 107px;
  height: 61px;
  left: -38px;
  bottom: 0;
  -webkit-transform: rotate(35deg);
          transform: rotate(35deg);
}

/* =========================
    RESPONSIVE
========================= */
@media (max-width: 991px) {
  .vintage-video-sec {
    padding: 0 0 60px;
  }
  .vintage-video-sec .paper-frame {
    width: 100%;
    max-width: 680px;
  }
}
@media (max-width: 767px) {
  .vintage-video-sec {
    padding: 20px 0 60px;
  }
  .vintage-video-sec .paper-frame {
    padding: 8px 8px 54px;
  }
  .vintage-video-sec .paper-frame .video-text {
    font-size: 14px;
    line-height: 22px;
    bottom: 14px;
  }
  .vintage-video-sec .paper-frame .tape-right {
    width: 93px;
    height: 45px;
    top: 0;
    right: -34px;
  }
  .vintage-video-sec .paper-frame .tape-left {
    width: 93px;
    height: 45px;
    left: -35px;
    bottom: -15px;
  }
}