}

h6 {
  font-size: clamp(14px, 1.8vw, 18px);
}

p, li {
  font-size: clamp(14px, 1.4vw, 16px);
  line-height: 1.6;
}

.clearfix:before, .clearfix:after {
  clear: both;
  content: "";
  display: table;
}

.clearfix:after {
  clear: both;
}

.clearfix {
  *zoom: 1;
