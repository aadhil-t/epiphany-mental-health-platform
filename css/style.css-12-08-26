          transform-origin: center;
  -webkit-transition: opacity 0.35s ease, -webkit-transform 0.35s ease;
  transition: opacity 0.35s ease, -webkit-transform 0.35s ease;
  transition: transform 0.35s ease, opacity 0.35s ease;
  transition: transform 0.35s ease, opacity 0.35s ease, -webkit-transform 0.35s ease;
  will-change: transform;
  -webkit-backface-visibility: hidden;
          backface-visibility: hidden;
}
.circle-btn .circle-arrow {
  /* initial arrow (centered) */
}
.circle-btn .circle-arrow .arrow {
  -webkit-transform: translate(-50%, -50%);
          transform: translate(-50%, -50%);
  opacity: 1;
  -webkit-box-shadow: none;
          box-shadow: none;
}
.circle-btn .circle-arrow {
  /* incoming arrow */
}
.circle-btn .circle-arrow::after {
  content: "";
  -webkit-transform: translate(-120%, 120%);
          transform: translate(-120%, 120%);
  opacity: 0;
}
.circle-btn .circle-arrow:hover .arrow {
  -webkit-transform: translate(120%, -120%);
          transform: translate(120%, -120%);
  opacity: 0;
}
.circle-btn .circle-arrow:hover::after {
  -webkit-transform: translate(-50%, -50%);
          transform: translate(-50%, -50%);
  opacity: 1;
}

