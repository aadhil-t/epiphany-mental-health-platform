          <?php
      $service_section = get_field('service_section');
     
      $selected_conditions = $service_section['select_conditions'];

      if ($selected_conditions) {
          $query = new WP_Query(array(
              'post_type' => 'service',
              'post__in'  => wp_list_pluck($selected_conditions, 'ID'),
              'orderby'   => 'post__in',
          ));
      } else {
          $query = new WP_Query(array(
              'post_type' => 'service',
              'posts_per_page' => 3,
          ));
      }

    if ($query->have_posts()):
    ?>

    <div class="conditions-grid">

      <?php
      $classes = ['ocd', 'ptsd', 'panic']; 
      $i = 0;

      while ($query->have_posts()): $query->the_post();

        $card_class = isset($classes[$i]) ? $classes[$i] : '';
      ?>

        <div class="condition-card<?php echo $card_class ? ' ' . esc_attr($card_class) : ''; ?>" data-aos="zoom-in">

          <div class="card-content">

            <h3><?php the_title(); ?></h3>

            <div class="content">
              <?php echo wp_trim_words(get_the_content(), 25); ?>
            </div>

            <a href="<?php the_permalink(); ?>" class="btn-outline">
              Learn More
            </a>

          </div>

        </div>

      <?php
        $i++;
      endwhile;
      wp_reset_postdata();
      ?>

    </div>

    <?php endif; ?>

 



